// The website on Cloudflare Workers: the built site as static assets, plus a small Worker
// (worker/index.js) for /api, which sets up visitors' relays.
// Workers Builds settings: root directory "frontend", build command "npm run build", deploy command "npx wrangler deploy".
{
  "name": "sayl",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    // unknown paths get build/404.html, which renders the error page
    "not_found_handling": "404-page",
    // /api goes to the Worker; everything else is a file
    "run_worker_first": ["/api/*"]
  }
}
