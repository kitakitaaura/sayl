# Copy to .env on the VPS and fill in every empty value.
# Generate secrets with: openssl rand -hex 32

# --- brand -------------------------------------------------------------------
# Overrides the name in brand.json. Set the same APP_NAME in Cloudflare Pages.
APP_NAME=Sayl

# --- docker compose ------------------------------------------------------------
# "public" also starts cloudflared (api) and caddy (downloads). Leave empty for local dev.
COMPOSE_PROFILES=public

# --- domains -------------------------------------------------------------------
# The Cloudflare Pages site. The API only accepts browser requests from here.
FRONTEND_ORIGIN=https://sayl.kitaaura.com
# DNS-only (grey cloud) record pointing at the VPS. Caddy gets its certificate.
DL_DOMAIN=sayl-dl.kitaaura.com

# --- cloudflare ----------------------------------------------------------------
# Zero Trust > Networks > Tunnels > your tunnel > install connector: the token after --token.
# Route sayl-api.kitaaura.com in that tunnel to http://backend:8080
TUNNEL_TOKEN=
# Turnstile secret key. Leave empty to turn the captcha off (local dev only).
# The matching site key is set in Cloudflare Pages as TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=

# --- secrets -------------------------------------------------------------------
# Signs session cookies. Changing it logs every visitor out.
SESSION_SECRET=
# Signs download links. Changing it breaks links already handed out.
DOWNLOAD_URL_SECRET=
# Beta access code. Leave empty to make the site public.
ACCESS_CODE=

# --- qbittorrent (internal only) -----------------------------------------------
QBIT_USERNAME=sayl
# 12+ characters. Only the backend uses it; qbittorrent's web ui is never exposed.
QBIT_PASSWORD=
# Peer port, open for TCP and UDP in Oracle's security list and the VPS firewall.
TORRENT_PORT=6881
# prefer | require | disable
ENCRYPTION_MODE=prefer
# Global caps in KiB/s. 0 = unlimited.
UPLOAD_LIMIT_KIBPS=5120
DOWNLOAD_LIMIT_KIBPS=0
# Most torrents running at once across all users.
GLOBAL_MAX_ACTIVE_TORRENTS=20
# IPv6 for peers. Set false only if the VPS kernel has IPv6 turned off.
ENABLE_IPV6=true

# --- limits --------------------------------------------------------------------
# Per session and per IP.
MAX_ACTIVE_PER_USER=3
MAX_STORAGE_PER_USER_GB=20
MAX_TORRENT_SIZE_GB=20
# New torrents are refused once reserved space would pass this.
GLOBAL_STORAGE_CAP_GB=120
# How long finished files stay, by selected size. gb:hours, smallest first.
RETENTION_TIERS=3:24,5:12,10:6,20:3
# Torrents with no progress for this long are deleted.
STALL_TIMEOUT_HOURS=6
# Seeding always stops after this many minutes, or at the ratio limit.
SEED_MAX_MINUTES=60
DEFAULT_RATIO_LIMIT=1.0
# Largest .torrent file accepted, in KB.
MAX_TORRENT_FILE_KB=4096

# --- logging -------------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
